# Aplicación
FLASK_APP_NAME='Reserva Espacios Backend'
FLASK_DEBUG=True
FLASK_SECRET_KEY='cambia-esto-por-un-string-secreto'

# Servidor
FLASK_HOST='0.0.0.0'
FLASK_PORT='5001'

# CORS
FLASK_CORS_ORIGINS='http://localhost:5173,http://localhost:8080,http://localhost:5001'

# Base de datos PostgreSQL
# Usar la URL con "postgres-db" si el backend corre dentro de Docker Compose
# Usar "localhost" si corre fuera de Docker
DATABASE_URL='postgresql://postgres:postgres@postgres-db:5432/reserva_espacios_um'
DATABASE_ECHO='False'
DATABASE_POOL_SIZE='5'
DATABASE_MAX_OVERFLOW='10'

# Redis (opcional)
REDIS_HOST=http://localhost
REDIS_PORT=6379
REDIS_PASSWORD=password

# Storage de imágenes de planos
# Compatible con AWS S3, DigitalOcean Spaces y Azure (ver README para cada caso)
AWS_ACCESS_KEY_ID=tu_access_key_id_aqui
AWS_SECRET_ACCESS_KEY=tu_secret_access_key_aqui
AWS_S3_BUCKET_NAME=nombre-de-tu-bucket
AWS_S3_REGION=sa-east-1
# Solo definir si usás DigitalOcean Spaces (o similar). Dejar vacío para AWS S3.
# S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com

# Keycloak
# KEYCLOAK_URL: URL interna (dentro de Docker usa "keycloak", fuera usa "localhost")
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=reserva-espacios
KEYCLOAK_CLIENT_ID=front-admin
KEYCLOAK_ISSUER_URL=http://localhost:8080
